# LangSmith tracing (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-api-key

# Neo4j Aura - HTTP Query API endpoint (used by fetch_graph.py)
AURA_URI=https://<db-id>.databases.neo4j.io/db/neo4j/query/v2

# Neo4j Aura - driver connection URI (used by text2cypher.py)
NEO4J_CONNECTION_URI=neo4j+s://<db-id>.databases.neo4j.io

# Neo4j credentials
NEO4J_USER=neo4j
NEO4J_PASS=your-neo4j-password
